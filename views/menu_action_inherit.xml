<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- Add RO group to the same menus/actions as Officer.
         Verify these XML IDs in your DB (Dev Mode → hover menu/action). -->
    <record id="website_slides.menu_website_slides" model="ir.ui.menu">
      <field name="groups_id" eval="[(4, ref('website_slides_officer_readonly.group_website_slides_officer_readonly'))]"/>
    </record>

    <record id="website_slides.slide_channel_action" model="ir.actions.act_window">
      <field name="groups_id" eval="[(4, ref('website_slides_officer_readonly.group_website_slides_officer_readonly'))]"/>
    </record>

    <record id="website_slides.action_slide_slide" model="ir.actions.act_window">
      <field name="groups_id" eval="[(4, ref('website_slides_officer_readonly.group_website_slides_officer_readonly'))]"/>
    </record>
  </data>
</odoo>
