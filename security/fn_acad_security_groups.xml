<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- New eLearning "Officer (Read Only)" group -->
        <record id="group_website_slides_officer_readonly" model="res.groups">
            <field name="name">Officer (Read Only)</field>
            <!-- Use the same category as eLearning groups so it appears in the same dropdown.
                 On standard installs this is 'base.module_category_website'. -->
            <field name="category_id" ref="base.module_category_website"/>
            <!-- Keep assignees internal; DO NOT imply Officer/Manager -->
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

         <!-- Make Officer imply our RO group so the category renders as a single selection chain:
         Officer (Read Only) < Officer < Manager -->

        <record id="website_slides.group_website_slides_officer" model="res.groups">
            <field name="implied_ids"
                   eval="[(4, ref('website_slides_officer_readonly.group_website_slides_officer_readonly'))]"/>
        </record>


    </data>

</odoo>
