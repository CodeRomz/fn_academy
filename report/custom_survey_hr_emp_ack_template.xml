<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="hr_emp_ack_report_view" priority="20">
            <t t-foreach="docs" t-as="user_input">
                <t t-call="web.html_container">
                    <t t-call="web.basic_layout">
                        <div class="page mx-0">
                            <div class="container">
                                <div class="row">
                                    <h1>
                                        <t t-esc="user_input.partner_id.name or user_input.email"/>
                                    </h1>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>