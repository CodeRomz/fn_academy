<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">


    <record id="survey_user_input_public_access" model="ir.rule">
        <field name="name">Public Access to Survey User Input</field>
        <field name="model_id" ref="survey.model_survey_user_input"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_public'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Channels: company-safe read -->
    <record id="rule_slide_channel_ro_read_company" model="ir.rule">
        <field name="name">Slide Channel - RO - Read (Company)</field>
        <field name="model_id" ref="website_slides.model_slide_channel"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('website_slides_officer_readonly.group_website_slides_officer_readonly'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Slides: company-safe read -->
    <record id="rule_slide_slide_ro_read_company" model="ir.rule">
        <field name="name">Slide - RO - Read (Company)</field>
        <field name="model_id" ref="website_slides.model_slide_slide"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('website_slides_officer_readonly.group_website_slides_officer_readonly'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Membership / progress (via channel.company_id) -->
    <record id="rule_slide_channel_partner_ro_read_company" model="ir.rule">
        <field name="name">Slide Channel Partner - RO - Read (Company)</field>
        <field name="model_id" ref="website_slides.model_slide_channel_partner"/>
        <field name="domain_force">['|', ('channel_id.company_id', '=', False), ('channel_id.company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('website_slides_officer_readonly.group_website_slides_officer_readonly'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Slide partner lines (via slide.company_id) -->
    <record id="rule_slide_slide_partner_ro_read_company" model="ir.rule">
        <field name="name">Slide Partner - RO - Read (Company)</field>
        <field name="model_id" ref="website_slides.model_slide_slide_partner"/>
        <field name="domain_force">['|', ('slide_id.company_id', '=', False), ('slide_id.company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('website_slides_officer_readonly.group_website_slides_officer_readonly'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Questions / quizzes (via slide.company_id) -->
    <record id="rule_slide_question_ro_read_company" model="ir.rule">
        <field name="name">Slide Question - RO - Read (Company)</field>
        <field name="model_id" ref="website_slides.model_slide_question"/>
        <field name="domain_force">['|', ('slide_id.company_id', '=', False), ('slide_id.company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('website_slides_officer_readonly.group_website_slides_officer_readonly'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>


</odoo>