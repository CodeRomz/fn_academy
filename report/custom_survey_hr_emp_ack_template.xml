<odoo>
    <template id="emp_ack_report_view" inherit_id="survey.emp_ack_report_view" priority="20">
        <xpath expr="." position="replace">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="user_input">
                    <!-- Certification Layout -->
                    <h1>
                        <t t-esc="user_input.partner_id.name or user_input.email"/>
                    </h1>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
