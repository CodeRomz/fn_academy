<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Actions (ours; no dependency on stock IDs) ===== -->

    <record id="action_fn_elearning_ro_channels" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">slide.channel</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="target">current</field>
        <field name="groups_id" eval="[(4, ref('fn_academy.group_website_slides_officer_readonly'))]"/>
    </record>

    <record id="action_fn_elearning_ro_slides" model="ir.actions.act_window">
        <field name="name">Slides</field>
        <field name="res_model">slide.slide</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="target">current</field>
        <field name="groups_id" eval="[(4, ref('fn_academy.group_website_slides_officer_readonly'))]"/>
    </record>

    <record id="action_fn_elearning_ro_tags" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">slide.tag</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
        <field name="groups_id" eval="[(4, ref('fn_academy.group_website_slides_officer_readonly'))]"/>
    </record>

    <!-- ===== Top-level App (RO only) =====
         Using web_icon from website_slides so it looks like the eLearning app.
    -->
    <menuitem id="menu_fn_elearning_ro_root"
              name="eLearning"
              sequence="45"
              groups="fn_academy.group_website_slides_officer_readonly"
              web_icon="website_slides,static/description/icon.png"/>

    <!-- Children -->
    <menuitem id="menu_fn_elearning_ro_channels"
              parent="menu_fn_elearning_ro_root"
              name="Courses"
              action="action_fn_elearning_ro_channels"
              sequence="1"
              groups="fn_academy.group_website_slides_officer_readonly"/>

    <menuitem id="menu_fn_elearning_ro_slides"
              parent="menu_fn_elearning_ro_root"
              name="Slides"
              action="action_fn_elearning_ro_slides"
              sequence="2"
              groups="fn_academy.group_website_slides_officer_readonly"/>

    <menuitem id="menu_fn_elearning_ro_tags"
              parent="menu_fn_elearning_ro_root"
              name="Tags"
              action="action_fn_elearning_ro_tags"
              sequence="3"
              groups="fn_academy.group_website_slides_officer_readonly"/>

</odoo>
