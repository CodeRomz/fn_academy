<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="hr_emp_ack_report_view" priority="20">
            <xpath expr="." position="replace">
                <t t-foreach="docs" t-as="user_input">
                    <t t-call="web.html_container">
                        <t t-call="web.basic_layout">
                            <div class="page mx-0">
                                <div class="container">
                                    <div class="row">
                                        <div class="col">
                                            <h1>
                                                <t t-esc="user_input.partner_id.name or user_input.email"/>
                                            </h1>
                                        </div>
                                        <div class="col">
                                            <h1>
                                                <t t-esc="user_input.partner_id.name or user_input.email"/>
                                            </h1>
                                        </div>
                                        <div class="col">
                                            <h1>
                                                <t t-esc="user_input.partner_id.name or user_input.email"/>
                                            </h1>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </t>
                    </t>
                </t>
            </xpath>
        </template>
    </data>
</odoo>